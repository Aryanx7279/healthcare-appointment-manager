# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthcare_db

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Redis (for BullMQ background jobs) ───────────────────────────────────────
# If Redis is not available, the system falls back to DB-based polling
REDIS_URL=redis://localhost:6379

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# For development, use Ethereal: https://ethereal.email (free mock SMTP)
# For production, use SendGrid, Mailgun, Gmail SMTP, etc.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-ethereal-user@ethereal.email
SMTP_PASS=your-ethereal-password
SMTP_FROM="HealthCare App <noreply@healthcare.app>"

# ─── OpenAI / LLM ─────────────────────────────────────────────────────────────
# Compatible with OpenAI, Azure OpenAI, or any OpenAI-compatible endpoint
# Leave blank to run in mock/fallback mode (no LLM summaries generated)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ─── Google Calendar (OAuth 2.0) ───────────────────────────────────────────────
# Create OAuth 2.0 credentials at: https://console.cloud.google.com
# Set Authorized redirect URI to: http://localhost:5000/api/calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/callback
