{
  "name": "backend",
  "version": "1.0.0",
  "description": "Healthcare Appointment Manager - Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "prisma migrate dev",
    "migrate:prod": "prisma migrate deploy",
    "generate": "prisma generate",
    "postinstall": "prisma generate",
    "seed": "ts-node prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "studio": "prisma studio",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand --forceExit",
    "lint": "tsc --noEmit",
    "format": "prettier --write src/**/*.ts"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "testTimeout": 30000
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "keywords": [
    "healthcare",
    "api",
    "backend"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.13.3",
    "body-parser": "^1.20.3",
    "date-fns": "^4.4.0",
    "denque": "^2.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "iconv-lite": "^0.7.3",
    "lodash": "^4.18.1",
    "prisma": "^6.4.0",
    "raw-body": "^2.5.2",
    "statuses": "^2.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "jiti": "^2.7.0",
    "signal-exit": "^4.1.0",
    "ts-node-dev": "^2.0.0",
    "write-file-atomic": "^7.0.1"
  }
}
